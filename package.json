{
  "name": "security-jeopardy",
  "version": "1.0.0",
  "private": true,
  "description": "SECURITY JEOPARDY - College Cybersecurity Competition Platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "prisma generate && npm --prefix server run build && npm --prefix client run build",
    "start": "npm --prefix server start",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:push": "npx prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "npm --prefix server test",
    "install:all": "npm install --include=dev && npm --prefix server install --include=dev && npm --prefix client install --include=dev",
    "admin:set-password": "tsx prisma/set-admin-password.ts",
    "event:reset": "tsx prisma/reset-event.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5"
  }
}
