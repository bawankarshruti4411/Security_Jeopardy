# Database Configuration
# Local Postgres: use the same URL for both.
# Neon: DATABASE_URL = pooled string (host has "-pooler"), DIRECT_URL = direct string.
#   e.g. postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/security_jeopardy?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/security_jeopardy?schema=public"

# Server Configuration
PORT=5000
NODE_ENV="development"
JWT_SECRET="security_jeopardy_secret_key_change_in_production_2026"

# Admin Account Credentials for Seeding
ADMIN_EMAIL="admin@cyberguardian.club"
ADMIN_PASSWORD="AdminJeopardy2026!"

# Optional: comma-separated allowed origins (only needed if the client is hosted on a different domain)
# CORS_ORIGINS="https://your-frontend.example.com"

# Client Configuration (only needed if the client is hosted separately from the API;
# put it in client/.env, the default is same-origin "/api")
# VITE_API_URL="https://your-api.example.com/api"
